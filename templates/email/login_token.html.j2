{% extends "layout.html.j2" %}

{% macro detail_icon(label) %}
<table
  role="presentation"
  width="32"
  height="32"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="width: 32px; height: 32px"
>
  <tr>
    <td
      role="img"
      aria-label="{{ label }}"
      style="
        width: 32px;
        height: 32px;
        background-color: #313244;
        border-radius: 6px;
        color: #a6adc8;
        font-size: 0;
        line-height: 0;
        text-align: center;
        vertical-align: middle;
      "
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="display: block; margin: 0 auto"
      >
        {{ caller() }}
      </svg>
    </td>
  </tr>
</table>
{% endmacro %}

{% block content %}
<tr>
  <td
    class="email-card"
    style="
      padding: 36px;
      background-color: #1e1e2e;
      border: 1px solid #313244;
      border-radius: 12px;
      color: #cdd6f4;
    "
  >
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td
          style="
            color: #cdd6f4;
            font-size: 24px;
            font-weight: 700;
            line-height: 30px;
            letter-spacing: -0.5px;
          "
        >
          You're almost there
        </td>
      </tr>

      <tr>
        <td
          style="
            padding: 8px 0 24px;
            color: #a6adc8;
            font-size: 15px;
            line-height: 24px;
          "
        >
          Click the button or use the code below to sign in.<br />
          Login attempt expires in
          <strong style="color: #cdd6f4; font-weight: 600">{{ expiry_time }} minutes</strong>.
        </td>
      </tr>

      <tr>
        <td style="padding-bottom: 24px; text-align: center">
          <table
            role="presentation"
            width="352"
            align="center"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 100%; max-width: 352px"
          >
            <tr>
              <td
                style="
                  height: 60px;
                  background-color: #89b4fa;
                  border-radius: 8px;
                  text-align: center;
                "
              >
                <a
                  href="{{ login_url }}"
                  style="
                    display: block;
                    padding: 17px 16px;
                    color: #1e1e2e;
                    font-size: 20px;
                    font-weight: 600;
                    line-height: 26px;
                    text-decoration: none;
                  "
                  >Sign In</a
                >
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td style="padding-bottom: 18px">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="vertical-align: middle">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="height: 1px; background-color: #313244; font-size: 1px; line-height: 1px">&nbsp;</td>
                  </tr>
                </table>
              </td>
              <td
                style="
                  width: 106px;
                  padding: 0 12px;
                  color: #7f849c;
                  font-size: 11px;
                  font-weight: 500;
                  line-height: 13px;
                  letter-spacing: 1.4px;
                  text-align: center;
                  text-transform: uppercase;
                  white-space: nowrap;
                "
              >
                or enter code
              </td>
              <td style="vertical-align: middle">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="height: 1px; background-color: #313244; font-size: 1px; line-height: 1px">&nbsp;</td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td style="padding-bottom: 24px; text-align: center">
          <span
            class="login-token"
            style="
              display: block;
              width: 100%;
              max-width: 352px;
              height: 62px;
              margin: 0 auto;
              box-sizing: border-box;
              background-color: #181825;
              border: 1px solid #45475a;
              border-radius: 8px;
              color: #cdd6f4;
              font-family: 'SF Mono', Monaco, Menlo, 'Courier New', monospace;
              font-size: 22px;
              font-weight: 600;
              line-height: 60px;
              text-align: center;
            "
          ><span class="login-token-spacing" style="letter-spacing: 40px">{{ token[:-1] }}</span><span
            style="letter-spacing: 0"
            >{{ token[-1] }}</span
          ></span>
        </td>
      </tr>

      <tr>
        <td style="padding-top: 20px; border-top: 1px solid #313244">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td
                colspan="3"
                style="
                  padding-bottom: 12px;
                  color: #7f849c;
                  font-size: 11px;
                  font-weight: 600;
                  line-height: 13px;
                  letter-spacing: 1.2px;
                  text-transform: uppercase;
                "
              >
                Sign-in attempt
              </td>
            </tr>
            <tr>
              <td class="details-column" style="width: 50%; vertical-align: top">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td
                      width="32"
                      style="
                        width: 32px;
                        vertical-align: top;
                      "
                    >
                      {% call detail_icon("Location") %}
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      {% endcall %}
                    </td>
                    <td style="padding-left: 10px; vertical-align: top">
                      <div style="color: #cdd6f4; font-size: 14px; font-weight: 500; line-height: 16px">
                        {% if ip_address and country_code %}
                          {% if country_flag %}<span
                            class="request-country-flag"
                            style="font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif"
                            >{{ country_flag }}</span
                          >&nbsp;{% endif %}<span class="request-country-code">{{ country_code }}</span>
                        {% else %}
                          <span class="request-country-code">Country Not Found</span>
                        {% endif %}
                      </div>
                      <div
                        class="request-ip-address"
                        style="color: #a6adc8; font-size: 12px; line-height: 16px; word-break: break-all"
                      >
                        {{ ip_address or "IP Not Found" }}
                      </div>
                    </td>
                  </tr>
                </table>
              </td>

              <td class="details-spacer" style="width: 16px">&nbsp;</td>

              <td class="details-column" style="width: 50%; vertical-align: top">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td
                      width="32"
                      style="
                        width: 32px;
                        vertical-align: top;
                      "
                    >
                      {% call detail_icon("Device") %}
                        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                      {% endcall %}
                    </td>
                    <td style="padding-left: 10px; vertical-align: top">
                      <div
                        class="request-operating-system"
                        style="
                          color: #cdd6f4;
                          font-size: 14px;
                          font-weight: 500;
                          line-height: 16px;
                          word-break: break-all;
                        "
                      >
                        {{ user_agent.operating_system if user_agent and user_agent.operating_system else "OS Not Found" }}
                      </div>
                      <div
                        class="request-browser"
                        style="color: #a6adc8; font-size: 12px; line-height: 16px; word-break: break-all"
                      >
                        {{ user_agent.browser if user_agent and user_agent.browser else "Browser Not Found" }}
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td
    style="
      padding: 20px 0 28px;
      color: #7f849c;
      font-size: 12px;
      line-height: 20px;
      text-align: center;
    "
  >
    <span class="safety-copy">Do not share this code.</span>
    <span class="safety-separator" style="padding: 0 10px; color: #585b70">&middot;</span>
    <span class="safety-copy">If you didn't request this email, you can safely ignore it.</span>
  </td>
</tr>
{% endblock %}
