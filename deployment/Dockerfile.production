# Documentation:
#   - https://docs.astral.sh/uv/guides/integration/docker/
#   - https://hynek.me/articles/docker-uv/

# python:3.15.2
FROM python@sha256:46837ed3105db0029b6d656816185c6258e3b39690532fb782428e0a5fd76182 AS build

ENV LANG=C.UTF-8
ENV TZ=Europe/Copenhagen

WORKDIR /src

# ghcr.io/astral-sh/uv:0.13.9
COPY --from=ghcr.io/astral-sh/uv@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d /uv /uvx /bin/
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=0 \
    UV_NO_DEV=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project

COPY . /src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable

# python:3.15.2-slim
FROM python@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

LABEL maintainer="Daniel Mizsak"
LABEL org.opencontainers.image.source="https://github.com/daniel-mizsak/lnkr-api"

ENV LANG=C.UTF-8
ENV TZ=Europe/Copenhagen

WORKDIR /app

RUN groupadd --system --gid 65532 nonroot && \
    useradd --system --uid 65532 --gid 65532 --shell /usr/sbin/nologin nonroot

COPY --chown=nonroot:nonroot alembic /app/alembic
COPY --chown=nonroot:nonroot alembic.ini /app/alembic.ini
COPY --chown=nonroot:nonroot asgi.py /app/asgi.py
COPY --chown=nonroot:nonroot templates /app/templates
COPY --chown=nonroot:nonroot --from=build /app/.venv /app/.venv

ENV ENVIRONMENT=production
ENV PATH="/app/.venv/bin:$PATH"

COPY --chown=nonroot:nonroot healthcheck.py /app/healthcheck.py
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["python", "/app/healthcheck.py"]

USER nonroot
EXPOSE 8000

# TODO: Access logs include URLs and query strings, which may contain tokens or other sensitive values.
CMD ["uvicorn", "asgi:app", "--proxy-headers", "--host", "0.0.0.0", "--port", "8000"]
